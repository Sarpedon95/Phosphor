<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store</string>
    <!-- teamID is injected by the CI "Set export team ID" step (PlistBuddy);
         xcodebuild does NOT expand $(...) in export option plists. -->
    <key>teamID</key>
    <string>TEAMID_PLACEHOLDER</string>
    <key>uploadBitcode</key>
    <false/>
    <key>uploadSymbols</key>
    <true/>
    <key>compileBitcode</key>
    <false/>
    <key>signingStyle</key>
    <string>manual</string>
    <!-- Provisioning profile mapping: all targets use the profile from PROVISIONING_PROFILE_SPECIFIER secret.
         The CI installs this as Phosphor.mobileprovision; the value below should match the
         "Name" field inside that provisioning profile (often displayed as the profile name in Xcode). -->
    <key>provisioningProfileMapping</key>
    <dict>
        <key>com.sarpedon.phosphor</key>
        <string>Phosphor Distribution</string>
        <key>com.sarpedon.phosphor.widgets</key>
        <string>Phosphor Distribution</string>
        <key>com.sarpedon.phosphor.liveactivity</key>
        <string>Phosphor Distribution</string>
    </dict>
    <key>stripSwiftSymbols</key>
    <true/>
    <key>destination</key>
    <string>export</string>
</dict>
</plist>
